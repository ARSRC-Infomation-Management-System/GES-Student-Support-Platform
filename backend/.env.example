# ASHANTI REGIONAL SRC INFORMATION MANAGEMENT SYSTEM Environment Variables Template

# Project Configuration
PROJECT_NAME="ASHANTI REGIONAL SRC INFORMATION MANAGEMENT SYSTEM"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS Configuration (Comma-separated origins for production)
CORS_ORIGINS="http://localhost:5173,https://arsrc.vercel.app"

# Security Configuration
SECRET_KEY="your_generated_64_character_hex_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL Engine Standardized Across All Environments)
DATABASE_URL="postgresql://username:password@localhost:5432/ges_student_support"

# Storage & Uploads
UPLOAD_DIR="./uploads"
