# GES Student Support & Communication Platform Environment Variables Template

# Project Configuration
PROJECT_NAME="GES Student Support & Communication Platform"
API_V1_STR="/api/v1"

# Security Configuration
SECRET_KEY="your_generated_64_character_hex_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL for Production)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name"

# Storage & Uploads
UPLOAD_DIR="./uploads"
